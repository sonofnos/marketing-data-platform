{
  "name": "pipeline_campaign_events",
  "properties": {
    "description": "Ingest campaign event JSONL from ADLS Gen2, transform to silver, trigger segment refresh via stored procedure.",
    "activities": [
      {
        "name": "CopyEventFiles",
        "type": "Copy",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 3,
          "retryIntervalInSeconds": 30
        },
        "typeProperties": {
          "source": {
            "type": "JsonSource",
            "storeSettings": {
              "type": "AzureBlobFSReadSettings",
              "recursive": true,
              "wildcardFolderPath": "@concat('events/', pipeline().parameters.runDate)",
              "wildcardFileName": "*.jsonl"
            },
            "formatSettings": {
              "type": "JsonReadSettings"
            }
          },
          "sink": {
            "type": "ParquetSink",
            "storeSettings": {
              "type": "AzureBlobFSWriteSettings",
              "copyBehavior": "MergeFiles"
            }
          },
          "enableStaging": false
        },
        "inputs": [
          {
            "referenceName": "ds_adls_events_jsonl",
            "type": "DatasetReference",
            "parameters": {
              "runDate": "@pipeline().parameters.runDate"
            }
          }
        ],
        "outputs": [
          {
            "referenceName": "ds_adls_bronze_parquet",
            "type": "DatasetReference",
            "parameters": {
              "container": "bronze",
              "folderPath": "@concat('campaign_events/', pipeline().parameters.runDate)",
              "fileName": "events.parquet"
            }
          }
        ]
      },
      {
        "name": "ValidateEventSchema",
        "type": "ExecuteDataFlow",
        "dependsOn": [
          {
            "activity": "CopyEventFiles",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "typeProperties": {
          "dataflow": {
            "referenceName": "df_validate_events",
            "type": "DataFlowReference"
          },
          "compute": {
            "coreCount": 16,
            "computeType": "MemoryOptimized"
          }
        }
      },
      {
        "name": "CheckRowCount",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "ValidateEventSchema",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "typeProperties": {
          "expression": {
            "value": "@greater(activity('CopyEventFiles').output.rowsCopied, 0)",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "name": "RefreshSegments",
              "type": "SqlServerStoredProcedure",
              "typeProperties": {
                "storedProcedureName": "sp_refresh_segments"
              },
              "linkedServiceName": {
                "referenceName": "ls_azure_sql",
                "type": "LinkedServiceReference"
              }
            }
          ],
          "ifFalseActivities": [
            {
              "name": "LogEmptyBatch",
              "type": "WebActivity",
              "typeProperties": {
                "url": "@pipeline().parameters.alertWebhookUrl",
                "method": "POST",
                "body": {
                  "message": "Empty event batch",
                  "runDate": "@pipeline().parameters.runDate",
                  "pipeline": "@pipeline().Pipeline"
                }
              }
            }
          ]
        }
      }
    ],
    "parameters": {
      "runDate": {
        "type": "string",
        "defaultValue": "@formatDateTime(utcNow(), 'yyyy-MM-dd')"
      },
      "alertWebhookUrl": {
        "type": "string"
      }
    },
    "triggers": [
      {
        "name": "DailyEventTrigger",
        "type": "ScheduleTrigger",
        "typeProperties": {
          "recurrence": {
            "frequency": "Day",
            "interval": 1,
            "startTime": "2026-01-01T02:00:00Z",
            "timeZone": "UTC"
          }
        }
      }
    ],
    "annotations": ["marketing-platform", "events", "streaming"],
    "lastPublishTime": "2026-11-01T00:00:00Z"
  },
  "type": "Microsoft.DataFactory/factories/pipelines"
}
